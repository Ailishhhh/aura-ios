{
  "expo": {
    "name": "Aura",
    "slug": "aura",
    "scheme": "aura",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0E0C",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "org.aura.music",
      "buildNumber": "2",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0E0C",
          "image": "./assets/img/icon-512-fg.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-font",
      "./plugins/withShareToAura"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
